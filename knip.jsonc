{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	"workspaces": {
		".": {
			// tools/upstream/vendor.sh runs write.mjs and Jest with jest.config.cjs, which loads
			// recorder.cjs by path, and the tests run tools/oracle/oracle.mjs. knip only looks for
			// entries in package.json scripts.
			"entry": ["tools/**/*.{mjs,cjs}"],
			// TSDoc's own tests, vendored as they are. Their imports are upstream's source, which
			// isn't here.
			"ignore": ["tests/upstream/suite/**"],
		},
		// The npm package. The root package.json lists no workspaces, so knip only finds it here, and
		// then takes its package.json's entries. Its tests run with `node --test`, which knip doesn't
		// see.
		"npm/tsdocrs": {
			"entry": ["*.test.mjs"],
		},
	},
}
